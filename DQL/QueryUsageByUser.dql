/*
Query to analyze query usage by user and calculate cost based on scanned bytes.
*/

fetch dt.system.events

//filter for queries
| filter event.kind == "QUERY_EXECUTION_EVENT"

// filter out tables that aren't billed
| filterOut table == "metrics" or table == "dt.system.events" or table ==""

// sum the total bytes scanned by user and table
| summarize total_scanned_bytes = sum(scanned_bytes), by: { user.email, user.id, table }

// FOR USE IN CUSTOMER ENVS, ADJUST RATE VALUE
// The rate is calculated as USD (for US customers) per 1000000 GiB scanned. This rate is usually the same across logs, spans and events.
| fieldsAdd rate = (2345.00/1000000.00)

// calculate cost based on total scanned bytes converted to GiB and rate
| fieldsAdd cost = rate * (total_scanned_bytes/1073741824.00)

// select relevant fields for output
| fields user.email, table, total_scanned_bytes, cost